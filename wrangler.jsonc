{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nimto-online",
  "main": "src/index.js",
  "compatibility_date": "2026-08-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NIMTO_ROOM",
        "class_name": "NimtoRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NimtoRoom"]
    }
  ]
}
